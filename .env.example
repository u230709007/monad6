# Default local demo: no real payments and no external AI calls.
APP_MODE=demo
APP_ORIGIN=http://localhost:5173
PORT=3001
# Demo/live use separate SQLite files by default. Node >=24 is required.
# DATABASE_PATH=data/buildproof-demo.sqlite

# Monad escrow runs on testnet only in this version.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
ESCROW_ADDRESS=
JURY_ADDRESSES=
TREASURY_ADDRESS=


# Live x402: use a facilitator-supported EVM network + EIP-3009 token.
# Native MON is escrow collateral; x402 AI payments use the configured token.
X402_FACILITATOR_URL=
X402_NETWORK=eip155:10143
X402_ASSET=
X402_PAY_TO=
X402_AMOUNT=10000
X402_TOKEN_NAME=
X402_TOKEN_VERSION=

# Only needed when explicitly deploying a new testnet contract.
DEPLOYER_PRIVATE_KEY=
# Unix seconds; default start +1 day, event 2 days, appeal 1 day.
EVENT_START=
# Optional ISO time (e.g. 2026-01-10T09:00:00Z). Enables "commits before event start" jury signals.
EVENT_START_ISO=
EVENT_END=
EVENT_DEADLINE=
APPEAL_SECONDS=86400
# Seats; later registrations join an on-chain waitlist.
EVENT_CAPACITY=50


# Optional: lets the AI read your repo and commit its changes (after you approve).
# Fine-grained token: https://github.com/settings/personal-access-tokens (Contents: read & write, only your repo).
GITHUB_TOKEN=

# LLM = SiloRail (https://silorail.com): no API key, pay per call over x402 (USDC on Monad).
# The agent wallet pays. Fund it with testnet USDC (asset 0x534b2f3A21130d7a60830c2Df862319e593943A3).
AGENT_PRIVATE_KEY=
SILORAIL_URL=https://testnet.silorail.com
# ":free" models work with the x402 `exact` scheme; mainnet: https://mainnet.silorail.com
SILORAIL_MODEL=google/gemma-4-31b-it:free
# Per-call ceiling in micro-USD (1e-6 USD).
SILORAIL_MAX_MICRO_USD=5000


# Step-by-step live setup guide (Turkish): docs/SETUP-LIVE.md
# Check your values any time with: npm run check:live

# Provider: silorail | openrouter | mock. Default: openrouter if OPENROUTER_API_KEY is set, else silorail.
# AI_PROVIDER=
# Server-side only. Fund it with the Monad MOST credit; participants never see a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
