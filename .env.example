# Default local demo: no real payments and no external AI calls.
APP_MODE=demo
APP_ORIGIN=http://localhost:5173
PORT=3001
# Demo/live use separate SQLite files by default. Node >=24 is required.
# DATABASE_PATH=data/buildproof-demo.sqlite

# Monad escrow runs on testnet only in this version.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
ESCROW_ADDRESS=
JURY_ADDRESSES=
TREASURY_ADDRESS=

# Server-only Anthropic credentials. Never prefix secrets with VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Live x402: use a facilitator-supported EVM network + EIP-3009 token.
# Native MON is escrow collateral; x402 AI payments use the configured token.
X402_FACILITATOR_URL=
X402_NETWORK=eip155:10143
X402_ASSET=
X402_PAY_TO=
X402_AMOUNT=10000
X402_TOKEN_NAME=
X402_TOKEN_VERSION=

# Only needed when explicitly deploying a new testnet contract.
DEPLOYER_PRIVATE_KEY=
# Unix seconds; default start +1 day, event 2 days, appeal 1 day.
EVENT_START=
EVENT_END=
EVENT_DEADLINE=
APPEAL_SECONDS=86400
